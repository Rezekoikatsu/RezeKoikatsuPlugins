<?xml version="1.0" encoding="utf-8"?>
<!--
  遊戲路徑只改這裡一個地方，所有專案都會跟著。
  Set your game path here once; every project follows.
  ゲームのパスはここ一か所だけ変更すれば、すべてのプロジェクトに反映されます。
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <KoikatuDir Condition="'$(KoikatuDir)' == ''">D:\Koikatu\</KoikatuDir>
    <KoikatuManagedDir>$(KoikatuDir)CharaStudio_Data\Managed\</KoikatuManagedDir>
    <KoikatuBepInExDir>$(KoikatuDir)BepInEx\</KoikatuBepInExDir>
    <KoikatuPluginDir>$(KoikatuDir)BepInEx\plugins\</KoikatuPluginDir>

    <!-- Koikatsu Sunshine：*.KKS.csproj 用這一組。沒有 Sunshine 的話，在 Visual Studio 把那兩個專案卸載即可。 -->
    <!-- Koikatsu Sunshine: used by the *.KKS.csproj projects. Without Sunshine, just unload those two projects. -->
    <!-- Koikatsu Sunshine：*.KKS.csproj が使います。Sunshine が無い場合は、その 2 つのプロジェクトをアンロードしてください。 -->
    <KoikatsuSunshineDir Condition="'$(KoikatsuSunshineDir)' == ''">D:\KoikatsuSunshine\</KoikatsuSunshineDir>
    <KksManagedDir>$(KoikatsuSunshineDir)CharaStudio_Data\Managed\</KksManagedDir>
    <KksBepInExDir>$(KoikatsuSunshineDir)BepInEx\</KksBepInExDir>
    <KksPluginDir>$(KoikatsuSunshineDir)BepInEx\plugins\</KksPluginDir>
  </PropertyGroup>
</Project>
