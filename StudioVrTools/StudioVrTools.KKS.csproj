<?xml version="1.0" encoding="utf-8"?>
<!--
  StudioVrTools 的 Koikatsu Sunshine 版。
  原始碼跟 StudioVrTools.csproj（Koikatsu 版）是同一份，這個專案只是換一組參照去編，並定義 KKS 符號。
  VR 插件一律走反射：Koikatsu 是 KKCharaStudioVR（VRGIN_KKCS），Sunshine 是 IllusionMods 的 KKS_VR（VRGIN_OpenXR），
  程式在執行時自己判斷是哪一套（VrInput 的轉接器模式），所以不需要參照任何 VR 的 dll。
  遊戲路徑在根目錄的 Directory.Build.props。

  The Koikatsu Sunshine build of StudioVrTools. Same sources as StudioVrTools.csproj; only the references differ.
  The VR plugin is reached through reflection only (KKCharaStudioVR on Koikatsu, IllusionMods KKS_VR on Sunshine).
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- 兩個專案放在同一個資料夾，中間檔一定要分開放，不然會互相蓋掉。這一段要在 Common.props 之前。 -->
    <BaseIntermediateOutputPath>obj\KKS\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C4F2A917-6E3B-4D58-A1C9-0B7E5D2F8A64}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>StudioVrTools</RootNamespace>
    <AssemblyName>StudioVrTools</AssemblyName>
    <!-- Sunshine 是 Unity 2019（.NET 4.x）。Visual Studio 沒裝這個版本的話，改成有裝的 4.x 版本即可（例如 v4.8）。 -->
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\KKS\Debug\</OutputPath>
    <IntermediateOutputPath>obj\KKS\Debug\</IntermediateOutputPath>
    <DefineConstants>DEBUG;TRACE;KKS</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\KKS\Release\</OutputPath>
    <IntermediateOutputPath>obj\KKS\Release\</IntermediateOutputPath>
    <DefineConstants>TRACE;KKS</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- 刻意「不」參照 StudioCutScene.dll 和任何 VR 的 dll（理由同 Koikatsu 版）。 -->
    <Reference Include="BepInEx">
      <HintPath>$(KksBepInExDir)core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Unity 2019 把引擎拆成很多個模組；UnityEngine.dll 本身只剩轉發，但 BepInEx 是對著它編的，所以也要參照。 -->
    <Reference Include="UnityEngine">
      <HintPath>$(KksManagedDir)UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KksManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KksManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KksManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KksManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KksManagedDir)UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KksManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.VRModule">
      <HintPath>$(KksManagedDir)UnityEngine.VRModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(KksManagedDir)UnityEngine.XRModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- 這個資料夾裡的 .cs 全部編進來，跟 Koikatsu 版用同一份原始碼 -->
    <Compile Include="*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="AfterBuild">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KksPluginDir)" ContinueOnError="true" />
  </Target>
</Project>
